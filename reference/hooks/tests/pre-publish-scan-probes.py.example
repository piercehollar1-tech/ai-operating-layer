    'unterminated heredoc dropped': 'an unterminated heredoc is kept whole',
    'untracked files not scanned': 'an untracked file added in the same command',
    'variable cd trusted': 'a cd target built from a variable',
    'visibility change not detected': 'gh repo edit --visibility public',
    'xargs/find not followed': 'xargs git push',
}


def main() -> int:
    if shutil.which("git") is None:
        print("FAIL: git is required", file=sys.stderr)
        return 1
    source = HOOK.read_text()
    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp)
        (base / "bin").mkdir()
        (base / "home").mkdir()
        (base / "bin" / "gh").write_text(GH_STUB)
        (base / "bin" / "gh").chmod(0o755)
        build(base)
        failed = 0

        print(f"{len(CASES)} cases against the hook as written:")
        for desc, ok, detail in run_cases(base, source):
            if not ok:
                print(f"  FAIL  {desc}  ({detail})")
            failed += not ok

        def mutate(mutation):
            label, old, new = mutation
            if source.count(old) != 1:
                return f"  STALE     {label}  (target text found {source.count(old)} times)", True
            red = [d for d, ok, _ in run_cases(base, source.replace(old, new), True,
                                               CAUGHT_BY.get(label)) if not ok]
            if red:
                return f"  KILLED    {label}  by: {red[0]}", False
            return f"  SURVIVED  {label}", True

        print(f"{len(MUTATIONS)} mutations (each must turn at least one case red):")
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
            for line, bad in pool.map(mutate, MUTATIONS):
                print(line)
                failed += bad

        total = len(CASES) + len(MUTATIONS)
        print(f"{total - failed}/{total} checks passed.")
        return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
