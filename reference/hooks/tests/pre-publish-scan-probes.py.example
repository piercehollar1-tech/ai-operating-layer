         dirty, 2)
    case("  (an API field)", 'gh api repos/example/public-repo/issues -f body="$(cat docs/spec.md)"',
         dirty, 2)
    case("the usual PR body form, carrying private text",
         "gh pr create -t x --head main --body \"$(cat <<'EOF'\nSeen in Exampleville.\nEOF\n)\"",
         clean, 2)
    case("  (${GIT:-/usr/bin/git} push)", "${GIT:-/usr/bin/git} push origin main", clean, 2,
         expect_in="command name")
    case("a command name AND its subcommand built by variables (\"$g\" \"$p\")",
         'g=git; p=push; "$g" "$p" origin main', clean, 2, expect_in="command name")
    case("text piped in through $(cat -)",
         'printf x | gh issue create -t note --body "$(cat -)"', clean, 2, expect_in="stdin")
    case("text from a shell variable (--title \"$BODY\")", 'gh issue create -t "$BODY" --body ok',
         clean, 2, expect_in="variable")
    case("  (a variable in an unquoted heredoc body)",
         'gh pr create -t x --head main --body "$(cat <<EOF\nhi $NOTES\nEOF\n)"', clean, 2,
         expect_in="variable")
    case("a pager set with git -c runs a command (core.pager)",
         "git -c core.pager='git push origin main' log", dirty, 2)
    case("  (GIT_PAGER=...)", "GIT_PAGER='git push origin main' git log", dirty, 2)
    case("  (MANPAGER=... man)", "MANPAGER='git push origin main' man ls", dirty, 2)
    case("  (man --pager=...)", "man --pager='git push origin main' ls", dirty, 2)
    case("  (man -P glued)", "man -P'git push origin main' ls", dirty, 2)
    case("text that is the output of another command is unseen",
