#!/usr/bin/env python3
# covers: pre-publish-scan.py.example
"""EXAMPLE probe suite for the publication gate. Runnable: this repository's CI runs it.

Four rules it demonstrates:

  * The case list starts with what the gate must BLOCK and what it must stay
    QUIET on, written the way commands really look -- chained, redirected,
    wrapped in `bash -lc`, multi-line, with heredocs -- not with what the code
    happens to do. A gate that blocks everything passes every "must block"
    case; the quiet cases catch that.

  * Every case runs the hook as a separate process, fed JSON on stdin, against
    throwaway repositories and a stub `gh` on PATH, with HOME redirected.
    Nothing touches the real home directory, a real repository, or the network.

  * A suite is only evidence if breaking the hook turns it red. Each mutation
    below edits a copy of the hook; at least one case must then fail. A
    mutation no case notices is a SURVIVOR (a real gap, or an equivalent mutant
    to retire with the reason written down). A mutation whose target text no
    longer exists is STALE: the hook changed and the suite did not. One that
    does not compile is BROKEN: its crash would turn every case red and prove
    nothing. Running every mutation takes far longer than the cases, so it is
    opt-in (--mutations): run it after changing the hook. A plain run still
    reports a STALE or BROKEN mutation, so the list cannot rot unseen.

  * A green suite is not a finished one. An earlier version passed with every
    mutation caught, and the next outside review still found a dozen more ways
    past the gate. Each finding from thirteen review rounds is now a case here.

Run: python3 reference/hooks/tests/pre-publish-scan-probes.py.example [--mutations]
"""

from __future__ import annotations

import concurrent.futures
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOOK = HERE.parent / "pre-publish-scan.py.example"
TERMS = HERE.parent / "private-terms.txt.example"

LEAK = "Our office is in Exampleville, on the internal-dashboard project.\n"
CLEAN = "Nothing private here.\n"
FAKE_AWS = "AKIA" + "EXAMPLEFAKE00000"  # built at runtime: this file carries no key shape
PRIVATE_URL = "https://github.com/example/private-repo.git"
PUBLIC_URL = "https://github.com/example/public-repo.git"

GH_STUB = """#!/bin/sh
case " $* " in *" --help "*) [ -z "$GH_NO_HELP" ] || exit 1 ;; esac
case " $* " in *" --help "*|" alias list ") PATH="${PATH#*:}" exec gh "$@" ;; esac
case "$*" in *"--jq .nameWithOwner"*)
  [ "$GH_MODE" = FAIL ] && exit 1; echo example/this-repo; exit 0 ;; esac
case "$GH_MODE" in
  PUBLIC|PRIVATE) echo "$GH_MODE" ;;
  BYURL) case "$3" in *public*) echo PUBLIC ;; *private*) echo PRIVATE ;; *) exit 1 ;; esac ;;
  HEREPRIVATE) case "$3" in *public*) echo PUBLIC ;; *) echo PRIVATE ;; esac ;;
  *) exit 1 ;;
esac
"""

CASES: list[dict] = []
_n = 0


def git(repo, *args):
    return subprocess.run(["git", "-c", "user.name=probe", "-c", "user.email=probe@example.com",
                           *args], cwd=repo, capture_output=True, text=True, timeout=30)


def case(desc, cmd, cwd, want, gh="PUBLIC", tool="Bash", expect_in=None, must_not_print=None,
         terms=None, env=None):
    payload = {"tool_name": tool, "cwd": str(cwd), "tool_input": {"command": cmd}}
    CASES.append({"desc": desc, "stdin": json.dumps(payload), "want": want, "gh": gh,
                  "expect_in": expect_in, "must_not_print": must_not_print, "terms": terms,
                  "env": env or {}})


def raw_case(desc, stdin, want):
    CASES.append({"desc": desc, "stdin": stdin, "want": want, "gh": "PUBLIC", "expect_in": None,
                  "must_not_print": None, "terms": None, "env": {}})


def build(base: Path) -> None:
    """Create every fixture once and register every case."""
    def repo(files=None, untracked=None, ignored=None, origin=PRIVATE_URL):
        global _n
        _n += 1
        r = base / "repos" / f"r{_n}"
        r.mkdir(parents=True)
        git(r, "init", "-q", "-b", "main")
        if origin:
            git(r, "remote", "add", "origin", origin)
        if ignored:
            (r / ".gitignore").write_text("\n".join(ignored) + "\n")
        for rel, body in (files or {"README.md": CLEAN}).items():
            p = r / rel
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(body) if isinstance(body, str) else p.write_bytes(body)
        git(r, "add", "-A")
        git(r, "commit", "-qm", "init")
        for rel, body in (untracked or {}).items():
            p = r / rel
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(body) if isinstance(body, str) else p.write_bytes(body)
        return r

    def pushed(r):
        git(r, "update-ref", "refs/remotes/origin/main", "HEAD")
        return r

    def cleaned(r, rel="a.md"):
        (r / rel).write_text(CLEAN)
        git(r, "commit", "-qam", "clean up")
        return r

    dirty = repo({"docs/spec.md": LEAK, "README.md": CLEAN})
    clean = repo()
    notrepo = base / "plain"
    notrepo.mkdir()

    # --- must block: a public destination with private data
    case("git push to a public repository", "git push origin main", dirty, 2,
         expect_in="docs/spec.md")
    case("  and the report never echoes the private text", "git push origin main", dirty, 2,
         must_not_print="Exampleville")
    case("a credential-shaped string, not echoed", "git push",
         repo({"README.md": f"key = {FAKE_AWS}\n"}), 2, must_not_print=FAKE_AWS)
    for label, key in (("Anthropic", "sk-" + "ant-api03-" + "Q" * 40),
                       ("OpenAI project", "sk-" + "proj-" + "Q" * 40)):
        case(f"an {label}-style key (hyphenated)", "git push",
             repo({"cfg.example": f"KEY={key}\n"}), 2, must_not_print=key)
    case("an untracked file added in the same command",
         "git add -A && git commit -m x && git push", repo(untracked={"notes.md": LEAK}), 2)
    case("a leak only in an unpushed commit", "git push origin main",
         cleaned(repo({"a.md": LEAK})), 2, expect_in="(unpushed commits)")
    r = repo({"a.md": CLEAN})
    (r / "a.md").write_text(LEAK)
    git(r, "add", "a.md")
    (r / "a.md").write_text(CLEAN)
    case("a leak only in the staged index", "git commit -m x && git push", r, 2,
         expect_in="(staged changes)")
    r = repo()
    (r / "a.md").write_text("++ " + LEAK)
    git(r, "add", "a.md")
    (r / "a.md").write_text(CLEAN)
    case("a staged line that itself starts with '++'", "git commit -m x && git push", r, 2)
    case("a binary-suffix file", "git push", repo(untracked={"scan.pdf": "%PDF\n" + LEAK}), 2)
    r = repo()
    (r / "blob.bin").write_bytes(b"\x00\x01" + LEAK.encode())
    git(r, "add", "blob.bin")
    (r / "blob.bin").write_bytes(b"\x00\x01clean")
    case("a staged binary blob", "git commit -m x && git push", r, 2)
    r = repo({"blob.bin": b"\x00\x01" + LEAK.encode()})
    (r / "blob.bin").write_bytes(b"\x00\x01clean")
    git(r, "commit", "-qam", "clean up")
    case("a binary blob in an unpushed commit", "git push", r, 2)
    case("a private file name, not echoed", "git push",
         repo(untracked={"exampleville-notes.md": CLEAN}), 2, expect_in="(a file name)",
         must_not_print="exampleville")
    case("  and still hidden when the contents leak too", "git push",
         repo(untracked={"exampleville-log.md": LEAK}), 2, must_not_print="exampleville")
    r = repo(untracked={"secret.txt": LEAK}, ignored=["secret.txt"])
    case("a force-added ignored file", "git add -f secret.txt && git push", r, 2)
    case("  (git add --force)", "git add --force secret.txt && git push", r, 2)
    case("  (git add --forc: an abbreviated --force)", "git add --forc secret.txt && git push", r,
         2)
    r = repo()
    git(r, "commit", "-q", "--allow-empty", "-m", "notes for the client-portal rollout")
    case("a private commit message", "git push", r, 2, expect_in="(commit messages)")
    super_r = repo()
    submod = Path(super_r) / "vendor"
    submod.mkdir()
    git(submod, "init", "-q", "-b", "main")
    git(submod, "remote", "add", "origin", PUBLIC_URL)
    (submod / "notes.md").write_text(LEAK)
    git(submod, "add", "-A")
    git(submod, "commit", "-qm", "init")
    git(super_r, "add", "vendor")
    git(super_r, "commit", "-qm", "add submodule")
    case("a recursive push publishes a submodule's commits (--recurse-submodules=on-demand)",
         "git push --recurse-submodules=on-demand origin main", super_r, 2, gh="BYURL")
    case("  (git -c push.recurseSubmodules=on-demand)",
         "git -c push.recurseSubmodules=on-demand push origin main", super_r, 2, gh="BYURL")
    case("  (=only pushes the submodules alone)", "git push --recurse-submodules=only origin main",
         super_r, 2, gh="BYURL")
    super_cfg = repo()
    submod2 = Path(super_cfg) / "vendor"
    submod2.mkdir()
    git(submod2, "init", "-q", "-b", "main")
    git(submod2, "remote", "add", "origin", PUBLIC_URL)
    (submod2 / "notes.md").write_text(LEAK)
    git(submod2, "add", "-A")
    git(submod2, "commit", "-qm", "init")
    git(super_cfg, "add", "vendor")
    git(super_cfg, "commit", "-qm", "add submodule")
    git(super_cfg, "config", "push.recurseSubmodules", "on-demand")
    case("  (push.recurseSubmodules=on-demand in the repository's config)", "git push origin main",
         super_cfg, 2, gh="BYURL")
    rewound = base / "repos" / "rewound-remote.git"
    subprocess.run(["git", "init", "-q", "--bare", "-b", "main", str(rewound)], capture_output=True)
    r = repo()
    git(r, "remote", "set-url", "origin", str(rewound))
    git(r, "push", "-q", "origin", "main")
    first = git(r, "rev-parse", "HEAD").stdout.strip()
    (Path(r) / "draft.md").write_text(LEAK)
    git(r, "add", "-A")
    git(r, "commit", "-qm", "draft")
    git(r, "rm", "-q", "draft.md")
    git(r, "commit", "-qm", "remove draft")
    git(r, "push", "-q", "origin", "main")
    git(rewound, "update-ref", "refs/heads/main", first)  # rewound elsewhere; not fetched here
    case("a rewound remote: stale tracking refs do not say what it has (git ls-remote does)",
         "git push origin main", r, 2, expect_in="(unpushed commits)")
    r = repo(untracked={" secret.txt": LEAK})
    case("a file name that starts with a space", "git push origin main", r, 2)
    clean_twin = repo()
    leaky_twin = Path(str(clean_twin) + " ")
    os.rename(repo({"a.md": LEAK}), leaky_twin)
    case("a repository folder whose name ends in a space is not mistaken for its neighbour",
         f"git push {PUBLIC_URL} main", leaky_twin, 2)
    case("GH_REPO sends gh to another repository",
         "GH_REPO=example/private-repo gh repo edit --visibility public", clean, 2,
         expect_in="GH_REPO")
    case("  (export GH_REPO, then gh)", "export GH_REPO=example/other && gh issue create -t x -b y",
         clean, 2, expect_in="GH_REPO")
    case("  (env GH_HOST=... gh)", "env GH_HOST=ghe.example.com gh issue create -t x -b y", clean,
         2, expect_in="GH_HOST")
    case("  (inherited from the environment)", "gh issue create -t x -b y", clean, 2,
         expect_in="GH_REPO", env={"GH_REPO": "example/other"})
    case("  QUIET: GH_REPO with a read", "GH_REPO=example/other gh issue list", clean, 0)
    case("  QUIET: GH_REPO with the repository named by --repo",
         "GH_REPO=example/other gh issue create -R example/public-repo -t x -b y", clean, 0)
    case("  QUIET: GH_HOST=github.com is the default host",
         "GH_HOST=github.com gh issue create -t x -b y", clean, 0)
    case("  QUIET: GH_REPO set only for a LATER gh",
         "gh issue create -t x -b y; GH_REPO=example/other gh issue list", clean, 0)
    case("a glued short option value (gh api -fbody=...)",
         'gh api repos/example/public-repo/issues -fbody="seen in Exampleville"', clean, 2)
    case("  (gh issue create -b'...')", "gh issue create -tx -b'seen in Exampleville'", clean, 2)
    super_only = repo({"a.md": LEAK}, origin=PUBLIC_URL)
    submod3 = Path(super_only) / "vendor"
    submod3.mkdir()
    git(submod3, "init", "-q", "-b", "main")
    git(submod3, "remote", "add", "origin", PUBLIC_URL)
    (submod3 / "notes.md").write_text(CLEAN)
    git(submod3, "add", "-A")
    git(submod3, "commit", "-qm", "init")
    git(super_only, "add", "vendor")
    git(super_only, "commit", "-qm", "add submodule")
    case("--recurse-submodules=on-demand still pushes the superproject",
         "git push --recurse-submodules=on-demand origin main", super_only, 2, gh="BYURL")
    case("the LAST --recurse-submodules wins (only, then on-demand: the superproject is pushed)",
         "git push --recurse-submodules=only --recurse-submodules=on-demand origin main",
         super_only, 2, gh="BYURL")
    case("  (the command's own flag beats git -c push.recurseSubmodules=only)",
         "git -c push.recurseSubmodules=only push --recurse-submodules=on-demand origin main",
         super_only, 2, gh="BYURL")
    case("  QUIET: on-demand, then only: the superproject is not pushed",
         "git push --recurse-submodules=on-demand --recurse-submodules=only origin main",
         super_only, 0, gh="BYURL")
    case("--no-recurse-submodules then --recurse-submodules=on-demand pushes the submodules",
         "git push --no-recurse-submodules --recurse-submodules=on-demand origin main", super_r,
         2, gh="BYURL")
    case("  QUIET: on-demand, then --no-recurse-sub (git takes a unique prefix)",
         "git push --recurse-submodules=on-demand --no-recurse-sub origin main", super_r, 0,
         gh="BYURL")
    case("an abbreviated option: git push --recurse-sub=on-demand",
         "git push --recurse-sub=on-demand origin main", super_r, 2, gh="BYURL")
    case("  (the value in the next word: --recurse-submodules on-demand)",
         "git push --recurse-submodules on-demand origin main", super_r, 2, gh="BYURL")
    r = repo()
    git(r, "commit", "-q", "--allow-empty", "-m", "ordinary", "-m", "author notes from Exampleville")
    git(r, "commit", "-q", "--allow-empty", "-m", "later")  # not the tip: the ref listing misses it
    case("a message line that starts with 'author ' is message, not identity", "git push", r, 2,
         expect_in="(commit messages)")
    r = repo()
    git(r, "branch", "exampleville-demo")
    case("a private branch name", "git push --all origin", r, 2)
    r = repo()
    git(r, "tag", "-a", "v1", "-m", "cut for client-portal")
    case("a private annotated tag message", "git push --tags", r, 2)
    r = pushed(repo())
    git(r, "notes", "add", "-m", "client-portal follow-up", "HEAD")
    case("--mirror publishes notes too", "git push --mirror origin", r, 2)
    case("  (git push --mirr: an abbreviated --mirror)", "git push --mirr origin", r, 2)
    case("git send-pack --stdin reads its refs from stdin: all of them count",
         "echo refs/notes/commits | git send-pack --stdin {PUBLIC_URL}", r, 2)
    case("  (an explicit refs/notes refspec)", "git push origin refs/notes/commits", r, 2)
    case("  QUIET: a normal push does not send notes", "git push origin main", r, 0)
    r = pushed(repo())
    git(r, "notes", "add", "-m", "client-portal follow-up", "HEAD")
    git(r, "config", "remote.origin.push", "refs/notes/*:refs/notes/*")
    case("a configured push refspec that sends notes", "git push origin", r, 2)
    r = pushed(repo())
    git(r, "notes", "add", "-m", "client-portal follow-up", "HEAD")
    git(r, "config", "remote.origin.mirror", "true")
    case("a remote configured as a mirror", "git push origin", r, 2)
    r = pushed(repo())
    git(r, "checkout", "-q", "--detach")
    (r / "d.md").write_text(LEAK)
    git(r, "add", "d.md")
    git(r, "commit", "-qm", "wip")
    git(r, "rm", "-q", "d.md")
    git(r, "commit", "-qm", "clean up")
    case("a detached HEAD pushed to a branch", "git push origin HEAD:refs/heads/review", r, 2)
    r = pushed(repo())
    git(r, "checkout", "-q", "-b", "scratch")
    (r / "d.md").write_text(LEAK)
    git(r, "add", "d.md")
    git(r, "commit", "-qm", "wip")
    sha = git(r, "rev-parse", "HEAD").stdout.strip()
    git(r, "checkout", "-q", "main")
    git(r, "branch", "-q", "-D", "scratch")
    case("a commit pushed by hash", f"git push origin {sha}:refs/heads/x", r, 2)
    r = repo()
    objects = r / ".git" / "lfs" / "objects" / "ab" / "cd"
    objects.mkdir(parents=True)
    (objects / ("abcd" + "0" * 60)).write_text(LEAK)
    case("a Git LFS object", "git push", r, 2, expect_in="(a Git LFS object)")
    r = repo()
    store = base / f"lfs-store-{_n}"
    (store / "objects" / "ab").mkdir(parents=True)
    (store / "objects" / "ab" / ("ab" + "1" * 62)).write_text(LEAK)
    git(r, "config", "lfs.storage", str(store))
    case("a Git LFS object in a custom lfs.storage", "git push", r, 2)
    r = repo()
    (r.parent / "Exampleville-target.md").write_text(CLEAN)
    os.symlink("../Exampleville-target.md", r / "link.md")
    case("a symlink's target text", "git add -A && git push", r, 2)
    r = repo()
    outside = base / "outside.md"
    outside.write_text(LEAK)
    os.symlink(str(outside), r / "pointer.md")
    case("  QUIET: a symlink to a leaky file outside the repo", "git add -A && git push", r, 0)
    case("a non-ASCII term in a UTF-8 file", "git push",
         repo({"a.md": "the café-secret\n"}), 2, terms="café-secret\n")
    case("a non-ASCII term in a Latin-1 file", "git push",
         repo({"a.md": "the café-secret\n".encode("latin-1")}), 2, terms="café-secret\n")
    case("a non-ASCII file's hit is reported once, not per decoding", "git push",
         repo({"a.md": "caf\u00e9 " + LEAK}), 2, expect_in="2 match(es)")
    case("a 2MB+ text file is scanned", "git push",
         repo(untracked={"huge.txt": LEAK + "x" * 2_100_000}), 2)

    # --- must block: fails closed
    case("unresolved visibility counts as public", "git push", dirty, 2, gh="FAIL")
    case("an unknown remote counts as public", "git push mirror main", dirty, 2, gh="PRIVATE")
    noremote = repo({"a.md": LEAK}, origin=None)
    case("a named remote that does not exist", "git push origin main", noremote, 2, gh="PRIVATE")
    r = repo({"a.md": LEAK}, origin=None)
    git(r, "config", "remote.pushDefault", PUBLIC_URL)
    case("a remote-less repo whose pushDefault is a URL", "git push", r, 2, gh="BYURL")
    case("a file over the size cap", "git push", repo(untracked={"big.log": "x" * 20_000_001}),
         2, expect_in="could not be scanned")
    if os.geteuid() != 0:
        r = repo(untracked={"locked.md": CLEAN})
        os.chmod(r / "locked.md", 0)
        case("an unreadable file", "git push", r, 2, expect_in="could not be scanned")
    case("a cd target built from a variable", 'cd "$REPO" && git push', clean, 2,
         expect_in="could not resolve")
    case("git --git-dir", "git --git-dir=/elsewhere/.git push", clean, 2)
    case("GIT_DIR=... git push", "GIT_DIR=/elsewhere/.git git push", clean, 2)
    case("git -c remote.X.url=... push",
         f"git -c remote.origin.url={PUBLIC_URL} -c remote.pushDefault=origin push", noremote, 2,
         gh="BYURL")
    case("git submodule foreach git push", "git submodule foreach git push", clean, 2)
    case("an empty term file", "git push", dirty, 2, terms="# only a comment\n",
         expect_in="term file is empty")
    case("a bad regex in the term file", "git push", dirty, 2, terms="(\n",
         expect_in="could not load the term file")
    case("a scan past its time budget", "git push", dirty, 2,
         env={"PUBLISH_GATE_BUDGET": "0"}, expect_in="budget")
    r = repo({"a.md": LEAK})
    for name, value in (("a", "!git b"), ("b", "!git c"), ("c", "!git d"), ("d", "!git e"),
                        ("e", "!git push origin main")):
        git(r, "config", f"alias.{name}", value)
    case("an alias chain deeper than the parser follows", "git a", r, 2,
         expect_in="nested too deeply")
    raw_case("a crash blocks (a non-string cwd)",
             json.dumps({"tool_name": "Bash", "cwd": 5, "tool_input": {"command": "git push"}}), 2)
    raw_case("a malformed payload that could be a publish", '{"tool_name": "Bash", git push', 2)
    raw_case("a payload without tool_name but with a push",
             json.dumps({"tool_input": {"command": "git push"}}), 2)

    # --- must block: the shapes commands really take
    case("git -C <dir> push", f"git -C {dirty} push origin main", clean, 2)
    case("git -c k=v -C <dir> push", f"git -c color.ui=never -C {dirty} push", clean, 2)
    case("cd <dir> && git push", f"cd {dirty} && git push", clean, 2)
    case("a relative cd", f"cd ../{dirty.name} && git push", clean, 2)
    case("cd on one line, push on the next", f"cd {dirty}\ngit push", clean, 2)
    case("bash -lc 'cd <dir> && git push'", f"bash -lc 'cd {dirty} && git push'", clean, 2)
    case('eval "git push"', 'eval "git push"', dirty, 2)
    case("a heredoc fed to bash", f"bash <<'EOF'\ncd {dirty} && git push\nEOF", clean, 2)
    case("a heredoc piped into sh", "cat <<'EOF' | sh\ngit push\nEOF", dirty, 2)
    case("a heredoc fed to /bin/bash", "/bin/bash <<EOF\ngit push\nEOF", dirty, 2)
    case("a heredoc fed to $SHELL", "$SHELL <<'EOF'\ngit push origin main\nEOF", dirty, 2)
    case("an unterminated heredoc is kept whole", "cat <<'EOF'\ngit push", dirty, 2)
    case("a push inside if/then", "if true; then git push origin main; fi", dirty, 2)
    case("a push inside a quoted $(...)", 'echo "$(git push origin main)"', dirty, 2)
    case("a quoted ')' inside a quoted $(...)",
         "echo \"$(printf '%s' ')'; git push origin main)\"", dirty, 2)
    case("a push inside a for loop", "for r in origin; do git push $r main; done", dirty, 2)
    case("a chained publish", "npm run build && git push", dirty, 2)
    case("piped and redirected", "git push origin main 2>&1 | tail -3", dirty, 2)
    case("timeout 60 git push", "timeout 60 git push", dirty, 2)
    case("VAR=x git push", "GIT_TRACE=0 git push", dirty, 2)
    case("env NAME=value git push", "env DEPLOY=1 git push origin main", dirty, 2)
    case("xargs git push", "echo origin | xargs git push", dirty, 2)
    case("find with a program name before -exec (find -name cd -exec git push)",
         "find . -name cd -exec git push origin main \\;", dirty, 2)
    case("  (script's log file named sh: script -q sh git push)", "script -q sh git push origin main",
         dirty, 2)
    case("a failed cd leaves the shell where it was", "cd /no/such/dir; git push", dirty, 2)
    r = repo({"a.md": LEAK})
    git(r, "config", "alias.shipit", "push --follow-tags")
    git(r, "remote", "add", "pub", PUBLIC_URL)
    git(r, "config", "alias.publish", "!git push pub main")
    git(r, "config", "alias.ship", "push pub main")
    git(r, "config", "alias.st", "status")
    case("a git alias that pushes", "git shipit", r, 2)
    case("a shell alias with its own public remote", "git publish", r, 2, gh="BYURL")
    case("a git alias with its own public remote", "git ship", r, 2, gh="BYURL")
    case("  QUIET: an alias that does not push", "git st", r, 0)

    # --- must block: the destination it really uses
    r = repo({"a.md": LEAK})
    git(r, "remote", "set-url", "--push", "origin", PUBLIC_URL)
    case("a push URL that differs from the fetch URL", "git push origin main", r, 2, gh="BYURL")
    r = repo({"a.md": LEAK})
    git(r, "remote", "set-url", "--add", "--push", "origin", PRIVATE_URL)
    git(r, "remote", "set-url", "--add", "--push", "origin", PUBLIC_URL)
    case("a private AND a public push URL", "git push origin main", r, 2, gh="BYURL")
    r = cleaned(pushed(repo({"a.md": LEAK})))
    git(r, "remote", "set-url", "--push", "origin", PUBLIC_URL)
    case("fetch-side tracking refs do not describe the push repo", "git push origin main", r, 2,
         gh="BYURL", expect_in="(unpushed commits)")
    r = repo({"a.md": LEAK})
    git(r, "remote", "add", "mirror", PUBLIC_URL)
    case("the second push in one command", "git push origin main && git push mirror main", r, 2,
         gh="BYURL")
    r = repo({"a.md": LEAK})
    git(r, "remote", "add", "mirror", PUBLIC_URL)
    git(r, "config", "remote.pushDefault", "mirror")
    case("a bare push follows remote.pushDefault", "git push", r, 2, gh="BYURL")
    case("a push straight to a public URL", f"git push {PUBLIC_URL} main", dirty, 2, gh="BYURL")
    r = cleaned(pushed(repo({"a.md": LEAK})))
    git(r, "remote", "add", "mirror", PUBLIC_URL)
    case("history on the private remote is new to the public one", "git push mirror main", r, 2,
         gh="BYURL")

    # --- must block: the gh publish surfaces
    case("gh repo create --public --source .", "gh repo create example/x --public --source . "
         "--push", dirty, 2, gh="FAIL")
    case("gh repo create --public --source <dir>",
         f"gh repo create example/x --public --source={dirty} --push", clean, 2, gh="FAIL")
    case("gh repo create --public with a private name", "gh repo create client-portal --public",
         notrepo, 2, gh="FAIL")
    case("gh repo create --public with a private description",
         'gh repo create example/x --public -d "the Exampleville build"', notrepo, 2, gh="FAIL")
    case("gh repo create --public from a private template",
         "gh repo create example/x --public --template example/private-template", notrepo, 2,
         gh="BYURL")
    case("gh repo edit --visibility public", "gh repo edit --visibility public", dirty, 2)
    case("gh repo edit --visibility=public", "gh repo edit --visibility=public", dirty, 2)
    r = pushed(cleaned(pushed(repo({"a.md": LEAK}))))
    case("making a repo public scans already-pushed history", "gh repo edit --visibility public",
         r, 2)
    case("making another repository public", "gh repo edit example/other --visibility public",
         clean, 2)
    r = repo(untracked={"notes.md": LEAK})
    case("gh gist create --public <leaky file>", "gh gist create --public notes.md", r, 2)
    case("gh gist create -p <leaky file>", "gh gist create -p notes.md", r, 2)
    case("  (gh's help unreadable, so -p is read as written)", "gh gist create -p notes.md", r, 2,
         env={"GH_NO_HELP": "1"})
    case("  QUIET: (help unreadable) a secret gist", "gh gist create notes.md", r, 0,
         env={"GH_NO_HELP": "1"})
    case("gh short flags bundled: gh gist create -pw", "gh gist create -pw notes.md", r, 2)
    case("  (a bool given a value: --public=true)", "gh gist create --public=true notes.md", r,
         2)
    case("  QUIET: --public=false is a secret gist", "gh gist create --public=false notes.md", r,
         0)
    case("  (-pd: public, and the description in the next word)",
         'gh gist create -pd "internal-dashboard notes" README.md', clean, 2)
    case("gh repo create --public=true", "gh repo create example/x --public=true --source=. --push",
         dirty, 2)
    case("gh repo edit --visibility PUBLIC (gh takes any case)",
         "gh repo edit --visibility PUBLIC --accept-visibility-change-consequences", dirty, 2)
    case("a group flag before the subcommand: gh issue -R <public> create",
         'gh issue -R example/public-repo create -t x -b "seen in Exampleville"', clean, 2,
         gh="HEREPRIVATE")
    case("  QUIET: gh issue -R <private> create", 'gh issue -R example/private-repo create -t x -b '
         '"seen in Exampleville"', clean, 0, gh="HEREPRIVATE")
    case("gh discussion create", 'gh discussion create -t x -b "seen in Exampleville"', clean,
         2)
    case("gh label create (the name is public)", "gh label create internal-dashboard -d x", clean, 2)
    case("  (gh label edit --name)", "gh label edit bug --name internal-dashboard", clean, 2)
    case("gh label clone from a private repository",
         "gh label clone example/private-repo -R example/public-repo", clean, 2, gh="BYURL")
    case("  QUIET: gh label clone from a public repository",
         "gh label clone example/public-repo -R example/public-repo", clean, 0, gh="BYURL")
    case("gh repo rename (the new name)", "gh repo rename internal-dashboard-tools", clean, 2)
    case("gh repo edit --add-topic", "gh repo edit --add-topic internal-dashboard", clean, 2)
    case("gh repo fork --fork-name", "gh repo fork example/public-repo --fork-name internal-dashboard-fork",
         clean, 2, gh="BYURL")
    case("gh gist rename (an existing gist: its visibility is not looked up)",
         "gh gist rename 0123abcd a.md Exampleville.md", clean, 2, gh="PRIVATE")
    case("gh project item-create (a project's visibility is not looked up)",
         'gh project item-create 1 --owner @me --title "internal-dashboard rollout"', clean, 2,
         gh="PRIVATE")
    case("  (gh project edit --visibility PUBLIC: its items are not scanned)",
         "gh project edit 1 --owner @me --visibility PUBLIC", clean, 2)
    case("gh agent-task create (the task and its pull request)",
         'gh agent-task create "draft the internal-dashboard rollout"', clean, 2)
    case("gh workflow run -f (a run's inputs)", 'gh workflow run d.yml -f note="internal-dashboard"', clean,
         2)
    case("gh skill publish releases this repository's skills", "gh skill publish", dirty, 2)
    case("  QUIET: gh skill publish --dry-run", "gh skill publish --dry-run", dirty, 0)
    case("a gh alias set in the same command",
         "gh alias set pv 'repo edit --visibility public' && gh pv", dirty, 2)
    case("  (a shell alias: gh alias set --shell)",
         """gh alias set --shell ip 'gh issue create -t x -b "seen in Exampleville"' && gh ip""",
         clean, 2)
    (base / "home" / ".config" / "gh").mkdir(parents=True, exist_ok=True)
    (base / "home" / ".config" / "gh" / "config.yml").write_text(
        "aliases:\n    pubit: repo edit --visibility public\n    co: pr checkout\n")
    case("  (an alias from gh's config)", "gh pubit", dirty, 2)
    case("  (GH_CONFIG_DIR: aliases from a config this gate does not read)",
         "GH_CONFIG_DIR=/tmp/elsewhere gh pubit2", dirty, 2)
    case("  (gh alias import, then an alias)", "gh alias import a.yml && gh pubit3", dirty, 2)
    case("export GIT_DIR sends a later push from another repository",
         "export GIT_DIR=/tmp/elsewhere/.git && git push origin main", clean, 2)
    case("  (declare -x GIT_WORK_TREE)", "declare -x GIT_WORK_TREE=/tmp/o; git push origin main",
         clean, 2)
    case("  QUIET: gh co (an alias for a read), gh auth status, an extension",
         "gh co 5; gh auth status; gh some-extension run", dirty, 0)
    case("a public gist from stdin", "echo hi | gh gist create --public -", clean, 2)
    case("a public gist of a missing file", "gh gist create --public nowhere.md", clean, 2)
    case("a public gist with a private description",
         'gh gist create --public README.md --desc "client-portal notes"', clean, 2)
    case("gh release create on a public repo", "gh release create v1", dirty, 2)
    r = pushed(repo(untracked={"dist/notes.txt": LEAK}))
    case("a leaky release asset", "gh release create v1 dist/notes.txt", r, 2)
    case("gh release upload of a leaky asset", "gh release upload v1 dist/notes.txt", r, 2)
    case("release notes with private text", 'gh release create v1 --notes "for client-portal"',
         pushed(repo()), 2)
    case("an issue body on a public repo",
         'gh issue create -R example/public-repo -t bug -b "seen in Exampleville"', notrepo, 2,
         gh="BYURL")
    case("a PR comment from a leaky file", "gh pr comment 5 --body-file notes.md",
         repo(untracked={"notes.md": LEAK}), 2)
    case("gh pr create may push the branch first", "gh pr create -t x -b y", dirty, 2)
    case("an issue body from stdin", "gh issue comment 5 -F -", clean, 2)
    case("gh api flipping a repository public",
         "gh api -X PATCH repos/example/x -f private=false", clean, 2)
    case("gh api setting visibility=public",
         "gh api -X PATCH repos/example/x -f visibility=public", clean, 2)
    r = repo(untracked={"visibility.json": '{"visibility": "public"}\n',
                        "mutation.json": '{"query": "mutation { addComment(input: {body: '
                                         '\\"client-portal\\"}) { clientMutationId } }"}\n'})
    case("gh api --input body that flips visibility, even on a private repo",
         "gh api -X PATCH repos/example/private-repo --input visibility.json", r, 2, gh="BYURL")
    case("a GraphQL mutation sent via --input", "gh api graphql --input mutation.json", r, 2)
    case("gh api body from stdin", "gh api repos/example/x/issues --input -", r, 2,
         expect_in="stdin")
    case("gh api posting private text to {owner}/{repo} when public",
         "gh api repos/{owner}/{repo}/issues -f body=client-portal", dirty, 2)
    case("gh api posting private text",
         "gh api repos/example/x/issues -f title=hi -f body=client-portal", clean, 2)

    # --- must block: the 2026-09-26 read-only audit's bypasses (F1-F6), all reproduced while
    # this suite was green, plus the neighbouring shapes found while fixing them
    case("F1 a cd inside an if that never runs",
         f"if false; then cd {clean}; fi; git push origin main", dirty, 2)
    case("F1 a cd after && that may not run", f"false && cd {clean}; git push origin main",
         dirty, 2)
    case("F1 a cd inside a loop body", f"while false; do cd {clean}; done; git push origin main",
         dirty, 2)
    case("F1 a cd inside a function that is never called",
         f"f() {{ cd {clean}; }}; git push origin main", dirty, 2)
    case("F1 a cd in a pipeline (a subshell in bash)", f"cd {clean} | cat; git push origin main",
         dirty, 2)
    case("F1 a cd at the end of a pipeline (zsh keeps it)",
         f"true | cd {clean}; git push origin main", dirty, 2)
    case("F1 a cd sent to the background", f"cd {clean} & git push origin main", dirty, 2)
    case("F1 a cd after || that never runs", f"true || cd {clean}; git push origin main", dirty,
         2)
    case("F1 a push after || runs where the && chain stopped",
         f"false && cd {clean} || git push origin main", dirty, 2)
    case("F1 a cd run by eval stays in the shell", f'eval "cd {dirty}"; git push origin main',
         clean, 2)
    case("F1 failed cds do not crowd out the real directory",
         "cd /no/a; cd /no/b; cd /no/c; cd /no/d; cd /no/e; git push origin main", dirty, 2)
    case("F1 a cd to a directory-stack entry", "cd +1 && git push origin main", clean, 2,
         expect_in="could not resolve")
    case("F1 zsh's two-argument cd rewrites the path",
         f"cd {clean.name} {dirty.name} && git push origin main", clean, 2)
    case("F1 a bare pushd swaps back", f"pushd {clean} && pushd; git push origin main", dirty, 2)
    locked = base / "locked-dir"
    locked.mkdir()
    locked.chmod(0)
    case("F1 a cd into a directory it cannot enter fails", f"cd {locked}; git push origin main",
         dirty, 2)
    case("F1 zsh autocd: a bare directory path is a cd", f"{dirty}\ngit push origin main",
         clean, 2)
    case("F1 a bare directory name in bash is not a cd", f"{clean}\ngit push origin main",
         dirty, 2)
    case("F1 text after # is a comment the shell never runs",
         f"true # ; cd {clean}\ngit push origin main", dirty, 2)
    case("a # that a shell without comments runs past", "echo hi # ; git push origin main",
         dirty, 2)
    case("F1 env cd runs an external cd", f"env cd {clean}; git push origin main", dirty, 2)
    case("F1 timeout N cd runs an external cd", f"timeout 5 cd {clean}; git push origin main",
         dirty, 2)
    case("F1 coproc runs its cd in a subshell", f"coproc cd {clean}; git push origin main",
         dirty, 2)
    case("a push run by coproc", "coproc git push origin main", dirty, 2)
    case("a quoted '<<EOF' starts no heredoc", "echo '<<EOF'\ngit push origin main\nEOF",
         dirty, 2)
    case("  (double-quoted too)", 'echo "<<EOF"\ngit push origin main\nEOF', dirty, 2)
    case("  (nor does one inside a comment)", "echo hi # <<EOF\ngit push origin main\nEOF",
         dirty, 2)
    case("a wrapper option that takes a value (env -u NAME)",
         "env -u GIT_CONFIG_GLOBAL git push origin main", dirty, 2)
    case("  (nice -n 5)", "nice -n 5 git push origin main", dirty, 2)
    case("  (timeout -s KILL 60)", "timeout -s KILL 60 git push origin main", dirty, 2)
    case("  (an option unknown to the gate, then git)", "nice -Z 5 git push origin main",
         dirty, 2)
    case("timeout N bash -c (the duration is not the command)",
         "timeout 5 bash -c 'git push origin main'", dirty, 2)
    case("  (an unknown option, then a shell)", "nice -Z 5 bash -c 'git push origin main'",
         dirty, 2)
    case("env -C <dir> runs the push in <dir>", f"env -C {dirty} git push origin main", clean, 2)
    case("env -S splits a string into the command", "env -S 'git push origin main'", dirty, 2)
    case("a wrapper named by its full path (/usr/bin/env -C)",
         f"/usr/bin/env -C {dirty} git push origin main", notrepo, 2)
    case("zsh's noglob runs the command after it", "noglob git push origin main", dirty, 2)
    case("  (inside zsh -c)", "zsh -fc 'noglob git push origin main'", dirty, 2)
    case("  (nocorrect)", "nocorrect git push origin main", dirty, 2)
    case("  (zsh's - modifier)", "- git push origin main", dirty, 2)
    case("  (noglob cd moves the shell)", f"noglob cd {dirty}; git push origin main", notrepo, 2)
    case("a program the gate has no list entry for runs git (arch)",
         "arch -arm64 git push origin main", dirty, 2)
    case("  (stdbuf)", "stdbuf -o0 git push origin main", dirty, 2)
    case("  (script)", "script -q /dev/null git push origin main", dirty, 2)
    case("  (taskpolicy, then a shell)", "taskpolicy -b zsh -c 'git push origin main'", dirty, 2)
    case("an unquoted dash delimiter still runs the body's $(...)",
