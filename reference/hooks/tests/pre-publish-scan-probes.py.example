         "git ship", dirty, 2)
    case("  (exported earlier in the command)",
         'export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=alias.ship '
         'GIT_CONFIG_VALUE_0="push origin main"; git ship', dirty, 2)
    case("  (exported, no value naming a push: the alias is in an included file)",
         "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=include.path GIT_CONFIG_VALUE_0=../ship.cfg; "
         "git ship", dirty, 2)
    case("an alias defined through git --config-env", "git --config-env alias.ship=SHIP ship",
         dirty, 2)
    dash = base / "repos" / "-dash"
