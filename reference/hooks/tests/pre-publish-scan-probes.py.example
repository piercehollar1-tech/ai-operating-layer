    case("a quoted command name (g'i't push)", "g'i't push origin main", dirty, 2)
    case("  (\"gi\"t)", '"gi"t push origin main', dirty, 2)
    case("  (every word quoted apart: g'i't p'u'sh)", "g'i't p'u'sh origin main", dirty, 2)
    case("zsh expands =git to git's path", "=git push origin main", dirty, 2)
    case("  (after a wrapper: nohup =git)", "nohup =git push origin main", dirty, 2)
    case("  (run by xargs: xargs =git)", "echo origin | xargs =git push", dirty, 2)
    case("a command name built by a substitution runs a push ($(which git) push)",
         "$(which git) push origin main", clean, 2, expect_in="command name")
    case("  (a variable: ${GIT:-git} push)", "${GIT:-git} push origin main", clean, 2,
         expect_in="command name")
    case("  (an ANSI-C escape: $'\\x67it' push)", "$'\\x67it' push origin main", clean, 2,
         expect_in="command name")
    case("  (run by xargs: xargs ${GIT} push)", "echo origin | xargs ${GIT} push", clean, 2,
         expect_in="command name")
    case("git subtree push publishes a split of this history",
         "git subtree push --prefix=docs origin main", dirty, 2)
    case("  (the prefix before the subcommand: git subtree -P docs push)",
         "git subtree -P docs push origin main", dirty, 2)
    case("git send-pack is the plumbing behind push", f"git send-pack {PUBLIC_URL} main", dirty,
         2)
    case("git lfs push uploads LFS objects", "git lfs push origin main", dirty, 2)
    case("gh gist edit --add a leaky file (the gist's visibility is not checked)",
         "gh gist edit 0123abcd --add docs/spec.md", dirty, 2)
    case("  (a local file replacing a gist file)",
         "gh gist edit 0123abcd --filename a.md docs/spec.md", dirty, 2)
    case("  (the description)", 'gh gist edit 0123abcd --desc "internal-dashboard notes"', clean, 2)
    case("gh issue close --comment posts text", 'gh issue close 5 --comment "seen in Exampleville"',
         clean, 2)
    case("  (gh pr close -c)", 'gh pr close 5 -c "seen in Exampleville"', clean, 2)
    case("  (gh issue reopen -c)", 'gh issue reopen 5 -c "seen in Exampleville"', clean, 2)
    case("  (gh pr merge --body: the merge commit)", 'gh pr merge 5 --body "seen in Exampleville"',
         clean, 2)
    case("  (gh pr merge -t: its subject)", 'gh pr merge 5 -t "internal-dashboard"', clean, 2)
    case("  (gh pr merge -F <leaky file>)", "gh pr merge 5 -F docs/spec.md", dirty, 2)
    case("gh repo edit --description on a public repo", 'gh repo edit --description "internal-dashboard"',
         clean, 2)
    case("  (gh's help unreadable: a glued -dVALUE)", 'gh repo edit -d"internal-dashboard"', clean,
         2, env={"GH_NO_HELP": "1"})
    case("  (another repo named, --homepage)",
         "gh repo edit example/public-repo -h https://example.test/internal-dashboard", notrepo, 2,
         gh="BYURL")
    case("an unquoted $(...) stays inside its word (git -C $(pwd) push)",
         "git -C $(pwd) push origin main", dirty, 2)
    case("  (git -c name=$(whoami) push)", "git -c user.name=$(whoami) push origin main", dirty,
         2)
    case("  (backquotes: git -C `git rev-parse --show-toplevel` push)",
         "git -C `git rev-parse --show-toplevel` push origin main", dirty, 2)
    case("text read from a file by $(cat ...) (gh issue create --body \"$(cat f)\")",
         'gh issue create -t x --body "$(cat docs/spec.md)"', dirty, 2, expect_in="spec.md")
    case("  (unquoted backquotes)", "gh pr comment 5 --body `cat docs/spec.md`", dirty,
