    case("  (and a body fed to a shell still runs)",
         "bash <<'END-OF-DATA'\ngit push origin main\nEND-OF-DATA", dirty, 2)
    case("a program given the push as one quoted word (watch)",
         "watch -n 1 'git push origin main'", dirty, 2)
    case("  (script -c)", "script -q -c 'git push origin main' /dev/null", dirty, 2)
    case("  (flock -c)", "flock /tmp/l -c 'git push origin main'", dirty, 2)
    case("  (man -P runs a pager command)", "man -P 'git push origin main' ls", dirty, 2)
    case("  (the push later in the quoted script: script -c 'echo; git push')",
         "script -q -c 'echo status; git push origin main' /dev/null", dirty, 2)
    case("  (flock -c 'true && git push')", "flock /tmp/l -c 'true && git push origin main'", dirty,
         2)
    case("a $ in a heredoc delimiter: a body fed to a shell still runs",
         "bash <<EOF$x\ngit push origin main\nEOF$x", dirty, 2)
    case("ripgrep --pre runs git with the searched path (rg --pre=git . push)",
         "rg --pre=git . push", dirty, 2)
    case("  (the value as its own word)", "rg --pre git . push", dirty, 2)
    case("a backslash-newline joins the lines (git \\ push)", "git \\\n  push origin main", dirty,
         2)
    case("  (inside the command name: gi\\ t)", "gi\\\nt push origin main", dirty, 2)
    two_remotes = repo({"a.md": LEAK})
    git(two_remotes, "remote", "add", "public", PUBLIC_URL)
    case("  (before the remote: git push \\ public main)", "git push \\\n  public main", two_remotes,
