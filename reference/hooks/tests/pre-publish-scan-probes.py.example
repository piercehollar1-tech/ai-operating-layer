#!/usr/bin/env python3
# covers: pre-publish-scan.py.example
"""EXAMPLE probe suite for the publication gate. Runnable: this repository's CI runs it.

Four rules it demonstrates:

  * The case list starts with what the gate must BLOCK and what it must stay
    QUIET on, written the way commands really look -- chained, redirected,
    wrapped in `bash -lc`, multi-line, with heredocs -- not with what the code
    happens to do. A gate that blocks everything passes every "must block"
    case; the quiet cases catch that.

  * Every case runs the hook as a separate process, fed JSON on stdin, against
    throwaway repositories and a stub `gh` on PATH, with HOME redirected.
    Nothing touches the real home directory, a real repository, or the network.

  * A suite is only evidence if breaking the hook turns it red. Each mutation
    below edits a copy of the hook; at least one case must then fail. A
    mutation no case notices is a SURVIVOR (a real gap, or an equivalent mutant
    to retire with the reason written down). A mutation whose target text no
    longer exists is STALE: the hook changed and the suite did not.

  * A green suite is not a finished one. An earlier version passed with every
    mutation caught, and the next outside review still found a dozen more ways
    past the gate. Each finding from four review rounds is now a case here.

Run: python3 reference/hooks/tests/pre-publish-scan-probes.py.example
"""

from __future__ import annotations

import concurrent.futures
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOOK = HERE.parent / "pre-publish-scan.py.example"
TERMS = HERE.parent / "private-terms.txt.example"

LEAK = "Our office is in Exampleville, on the internal-dashboard project.\n"
CLEAN = "Nothing private here.\n"
FAKE_AWS = "AKIA" + "EXAMPLEFAKE00000"  # built at runtime: this file carries no key shape
PRIVATE_URL = "https://github.com/example/private-repo.git"
PUBLIC_URL = "https://github.com/example/public-repo.git"

GH_STUB = """#!/bin/sh
case "$*" in *"--jq .nameWithOwner"*)
  [ "$GH_MODE" = FAIL ] && exit 1; echo example/this-repo; exit 0 ;; esac
case "$GH_MODE" in
  PUBLIC|PRIVATE) echo "$GH_MODE" ;;
  BYURL) case "$3" in *public*) echo PUBLIC ;; *private*) echo PRIVATE ;; *) exit 1 ;; esac ;;
  *) exit 1 ;;
esac
"""

CASES: list[dict] = []
_n = 0


def git(repo, *args):
    return subprocess.run(["git", "-c", "user.name=probe", "-c", "user.email=probe@example.com",
                           *args], cwd=repo, capture_output=True, text=True, timeout=30)


def case(desc, cmd, cwd, want, gh="PUBLIC", tool="Bash", expect_in=None, must_not_print=None,
         terms=None, env=None):
    payload = {"tool_name": tool, "cwd": str(cwd), "tool_input": {"command": cmd}}
    CASES.append({"desc": desc, "stdin": json.dumps(payload), "want": want, "gh": gh,
                  "expect_in": expect_in, "must_not_print": must_not_print, "terms": terms,
                  "env": env or {}})


def raw_case(desc, stdin, want):
    CASES.append({"desc": desc, "stdin": stdin, "want": want, "gh": "PUBLIC", "expect_in": None,
                  "must_not_print": None, "terms": None, "env": {}})


def build(base: Path) -> None:
    """Create every fixture once and register every case."""
    def repo(files=None, untracked=None, ignored=None, origin=PRIVATE_URL):
        global _n
        _n += 1
        r = base / "repos" / f"r{_n}"
        r.mkdir(parents=True)
        git(r, "init", "-q", "-b", "main")
        if origin:
            git(r, "remote", "add", "origin", origin)
        if ignored:
            (r / ".gitignore").write_text("\n".join(ignored) + "\n")
        for rel, body in (files or {"README.md": CLEAN}).items():
            p = r / rel
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(body) if isinstance(body, str) else p.write_bytes(body)
        git(r, "add", "-A")
        git(r, "commit", "-qm", "init")
        for rel, body in (untracked or {}).items():
            p = r / rel
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(body) if isinstance(body, str) else p.write_bytes(body)
        return r

    def pushed(r):
        git(r, "update-ref", "refs/remotes/origin/main", "HEAD")
        return r

    def cleaned(r, rel="a.md"):
        (r / rel).write_text(CLEAN)
        git(r, "commit", "-qam", "clean up")
        return r

    dirty = repo({"docs/spec.md": LEAK, "README.md": CLEAN})
    clean = repo()
    notrepo = base / "plain"
    notrepo.mkdir()

    # --- must block: a public destination with private data
    case("git push to a public repository", "git push origin main", dirty, 2,
         expect_in="docs/spec.md")
    case("  and the report never echoes the private text", "git push origin main", dirty, 2,
         must_not_print="Exampleville")
    case("a credential-shaped string, not echoed", "git push",
         repo({"README.md": f"key = {FAKE_AWS}\n"}), 2, must_not_print=FAKE_AWS)
    for label, key in (("Anthropic", "sk-" + "ant-api03-" + "Q" * 40),
                       ("OpenAI project", "sk-" + "proj-" + "Q" * 40)):
        case(f"an {label}-style key (hyphenated)", "git push",
             repo({"cfg.example": f"KEY={key}\n"}), 2, must_not_print=key)
    case("an untracked file added in the same command",
         "git add -A && git commit -m x && git push", repo(untracked={"notes.md": LEAK}), 2)
    case("a leak only in an unpushed commit", "git push origin main",
         cleaned(repo({"a.md": LEAK})), 2, expect_in="(unpushed commits)")
    r = repo({"a.md": CLEAN})
    (r / "a.md").write_text(LEAK)
    git(r, "add", "a.md")
    (r / "a.md").write_text(CLEAN)
    case("a leak only in the staged index", "git commit -m x && git push", r, 2,
         expect_in="(staged changes)")
    r = repo()
    (r / "a.md").write_text("++ " + LEAK)
    git(r, "add", "a.md")
    (r / "a.md").write_text(CLEAN)
    case("a staged line that itself starts with '++'", "git commit -m x && git push", r, 2)
    case("a binary-suffix file", "git push", repo(untracked={"scan.pdf": "%PDF\n" + LEAK}), 2)
    r = repo()
    (r / "blob.bin").write_bytes(b"\x00\x01" + LEAK.encode())
    git(r, "add", "blob.bin")
    (r / "blob.bin").write_bytes(b"\x00\x01clean")
    case("a staged binary blob", "git commit -m x && git push", r, 2)
    r = repo({"blob.bin": b"\x00\x01" + LEAK.encode()})
    (r / "blob.bin").write_bytes(b"\x00\x01clean")
    git(r, "commit", "-qam", "clean up")
    case("a binary blob in an unpushed commit", "git push", r, 2)
    case("a private file name, not echoed", "git push",
         repo(untracked={"exampleville-notes.md": CLEAN}), 2, expect_in="(a file name)",
         must_not_print="exampleville")
    case("  and still hidden when the contents leak too", "git push",
         repo(untracked={"exampleville-log.md": LEAK}), 2, must_not_print="exampleville")
    r = repo(untracked={"secret.txt": LEAK}, ignored=["secret.txt"])
    case("a force-added ignored file", "git add -f secret.txt && git push", r, 2)
    case("  (git add --force)", "git add --force secret.txt && git push", r, 2)
    r = repo()
    git(r, "commit", "-q", "--allow-empty", "-m", "notes for the client-portal rollout")
    case("a private commit message", "git push", r, 2, expect_in="(commit messages)")
    r = repo()
    git(r, "branch", "exampleville-demo")
    case("a private branch name", "git push --all origin", r, 2)
    r = repo()
    git(r, "tag", "-a", "v1", "-m", "cut for client-portal")
    case("a private annotated tag message", "git push --tags", r, 2)
    r = pushed(repo())
    git(r, "notes", "add", "-m", "client-portal follow-up", "HEAD")
    case("--mirror publishes notes too", "git push --mirror origin", r, 2)
    case("  (an explicit refs/notes refspec)", "git push origin refs/notes/commits", r, 2)
    case("  QUIET: a normal push does not send notes", "git push origin main", r, 0)
    r = pushed(repo())
    git(r, "notes", "add", "-m", "client-portal follow-up", "HEAD")
    git(r, "config", "remote.origin.push", "refs/notes/*:refs/notes/*")
    case("a configured push refspec that sends notes", "git push origin", r, 2)
    r = pushed(repo())
    git(r, "notes", "add", "-m", "client-portal follow-up", "HEAD")
    git(r, "config", "remote.origin.mirror", "true")
    case("a remote configured as a mirror", "git push origin", r, 2)
    r = pushed(repo())
    git(r, "checkout", "-q", "--detach")
    (r / "d.md").write_text(LEAK)
    git(r, "add", "d.md")
    git(r, "commit", "-qm", "wip")
    git(r, "rm", "-q", "d.md")
    git(r, "commit", "-qm", "clean up")
    case("a detached HEAD pushed to a branch", "git push origin HEAD:refs/heads/review", r, 2)
    r = pushed(repo())
    git(r, "checkout", "-q", "-b", "scratch")
    (r / "d.md").write_text(LEAK)
    git(r, "add", "d.md")
    git(r, "commit", "-qm", "wip")
    sha = git(r, "rev-parse", "HEAD").stdout.strip()
    git(r, "checkout", "-q", "main")
    git(r, "branch", "-q", "-D", "scratch")
    case("a commit pushed by hash", f"git push origin {sha}:refs/heads/x", r, 2)
    r = repo()
    objects = r / ".git" / "lfs" / "objects" / "ab" / "cd"
    objects.mkdir(parents=True)
    (objects / ("abcd" + "0" * 60)).write_text(LEAK)
    case("a Git LFS object", "git push", r, 2, expect_in="(a Git LFS object)")
    r = repo()
    store = base / f"lfs-store-{_n}"
    (store / "objects" / "ab").mkdir(parents=True)
    (store / "objects" / "ab" / ("ab" + "1" * 62)).write_text(LEAK)
    git(r, "config", "lfs.storage", str(store))
    case("a Git LFS object in a custom lfs.storage", "git push", r, 2)
    r = repo()
    (r.parent / "Exampleville-target.md").write_text(CLEAN)
    os.symlink("../Exampleville-target.md", r / "link.md")
    case("a symlink's target text", "git add -A && git push", r, 2)
    r = repo()
    outside = base / "outside.md"
    outside.write_text(LEAK)
    os.symlink(str(outside), r / "pointer.md")
    case("  QUIET: a symlink to a leaky file outside the repo", "git add -A && git push", r, 0)
    case("a non-ASCII term in a UTF-8 file", "git push",
         repo({"a.md": "the café-secret\n"}), 2, terms="café-secret\n")
    case("a non-ASCII term in a Latin-1 file", "git push",
         repo({"a.md": "the café-secret\n".encode("latin-1")}), 2, terms="café-secret\n")
    case("a non-ASCII file's hit is reported once, not per decoding", "git push",
         repo({"a.md": "caf\u00e9 " + LEAK}), 2, expect_in="2 match(es)")
    case("a 2MB+ text file is scanned", "git push",
         repo(untracked={"huge.txt": LEAK + "x" * 2_100_000}), 2)

    # --- must block: fails closed
    case("unresolved visibility counts as public", "git push", dirty, 2, gh="FAIL")
    case("an unknown remote counts as public", "git push mirror main", dirty, 2, gh="PRIVATE")
    noremote = repo({"a.md": LEAK}, origin=None)
    case("a named remote that does not exist", "git push origin main", noremote, 2, gh="PRIVATE")
    r = repo({"a.md": LEAK}, origin=None)
    git(r, "config", "remote.pushDefault", PUBLIC_URL)
    case("a remote-less repo whose pushDefault is a URL", "git push", r, 2, gh="BYURL")
    case("a file over the size cap", "git push", repo(untracked={"big.log": "x" * 20_000_001}),
         2, expect_in="could not be scanned")
    if os.geteuid() != 0:
        r = repo(untracked={"locked.md": CLEAN})
        os.chmod(r / "locked.md", 0)
        case("an unreadable file", "git push", r, 2, expect_in="could not be scanned")
    case("a cd target built from a variable", 'cd "$REPO" && git push', clean, 2,
         expect_in="could not resolve")
    case("git --git-dir", "git --git-dir=/elsewhere/.git push", clean, 2)
    case("GIT_DIR=... git push", "GIT_DIR=/elsewhere/.git git push", clean, 2)
    case("git -c remote.X.url=... push",
         f"git -c remote.origin.url={PUBLIC_URL} -c remote.pushDefault=origin push", noremote, 2,
         gh="BYURL")
    case("git submodule foreach git push", "git submodule foreach git push", clean, 2)
    case("an empty term file", "git push", dirty, 2, terms="# only a comment\n",
         expect_in="term file is empty")
    case("a bad regex in the term file", "git push", dirty, 2, terms="(\n",
         expect_in="could not load the term file")
    case("a scan past its time budget", "git push", dirty, 2,
         env={"PUBLISH_GATE_BUDGET": "0"}, expect_in="budget")
    r = repo({"a.md": LEAK})
    for name, value in (("a", "!git b"), ("b", "!git c"), ("c", "!git d"), ("d", "!git e"),
                        ("e", "!git push origin main")):
        git(r, "config", f"alias.{name}", value)
    case("an alias chain deeper than the parser follows", "git a", r, 2,
         expect_in="nested too deeply")
    raw_case("a crash blocks (a non-string cwd)",
             json.dumps({"tool_name": "Bash", "cwd": 5, "tool_input": {"command": "git push"}}), 2)
    raw_case("a malformed payload that could be a publish", '{"tool_name": "Bash", git push', 2)
    raw_case("a payload without tool_name but with a push",
             json.dumps({"tool_input": {"command": "git push"}}), 2)

    # --- must block: the shapes commands really take
    case("git -C <dir> push", f"git -C {dirty} push origin main", clean, 2)
    case("git -c k=v -C <dir> push", f"git -c color.ui=never -C {dirty} push", clean, 2)
    case("cd <dir> && git push", f"cd {dirty} && git push", clean, 2)
    case("a relative cd", f"cd ../{dirty.name} && git push", clean, 2)
    case("cd on one line, push on the next", f"cd {dirty}\ngit push", clean, 2)
    case("bash -lc 'cd <dir> && git push'", f"bash -lc 'cd {dirty} && git push'", clean, 2)
    case('eval "git push"', 'eval "git push"', dirty, 2)
    case("a heredoc fed to bash", f"bash <<'EOF'\ncd {dirty} && git push\nEOF", clean, 2)
    case("a heredoc piped into sh", "cat <<'EOF' | sh\ngit push\nEOF", dirty, 2)
    case("a heredoc fed to /bin/bash", "/bin/bash <<EOF\ngit push\nEOF", dirty, 2)
    case("a heredoc fed to $SHELL", "$SHELL <<'EOF'\ngit push origin main\nEOF", dirty, 2)
    case("an unterminated heredoc is kept whole", "cat <<'EOF'\ngit push", dirty, 2)
    case("a push inside if/then", "if true; then git push origin main; fi", dirty, 2)
    case("a push inside a quoted $(...)", 'echo "$(git push origin main)"', dirty, 2)
    case("a quoted ')' inside a quoted $(...)",
         "echo \"$(printf '%s' ')'; git push origin main)\"", dirty, 2)
    case("a push inside a for loop", "for r in origin; do git push $r main; done", dirty, 2)
    case("a chained publish", "npm run build && git push", dirty, 2)
    case("piped and redirected", "git push origin main 2>&1 | tail -3", dirty, 2)
    case("timeout 60 git push", "timeout 60 git push", dirty, 2)
    case("VAR=x git push", "GIT_TRACE=0 git push", dirty, 2)
    case("env NAME=value git push", "env DEPLOY=1 git push origin main", dirty, 2)
    case("xargs git push", "echo origin | xargs git push", dirty, 2)
    case("a failed cd leaves the shell where it was", "cd /no/such/dir; git push", dirty, 2)
    r = repo({"a.md": LEAK})
    git(r, "config", "alias.shipit", "push --follow-tags")
    git(r, "remote", "add", "pub", PUBLIC_URL)
    git(r, "config", "alias.publish", "!git push pub main")
    git(r, "config", "alias.ship", "push pub main")
    git(r, "config", "alias.st", "status")
    case("a git alias that pushes", "git shipit", r, 2)
    case("a shell alias with its own public remote", "git publish", r, 2, gh="BYURL")
    case("a git alias with its own public remote", "git ship", r, 2, gh="BYURL")
    case("  QUIET: an alias that does not push", "git st", r, 0)

    # --- must block: the destination it really uses
    r = repo({"a.md": LEAK})
    git(r, "remote", "set-url", "--push", "origin", PUBLIC_URL)
    case("a push URL that differs from the fetch URL", "git push origin main", r, 2, gh="BYURL")
    r = repo({"a.md": LEAK})
    git(r, "remote", "set-url", "--add", "--push", "origin", PRIVATE_URL)
    git(r, "remote", "set-url", "--add", "--push", "origin", PUBLIC_URL)
    case("a private AND a public push URL", "git push origin main", r, 2, gh="BYURL")
    r = cleaned(pushed(repo({"a.md": LEAK})))
    git(r, "remote", "set-url", "--push", "origin", PUBLIC_URL)
    case("fetch-side tracking refs do not describe the push repo", "git push origin main", r, 2,
         gh="BYURL", expect_in="(unpushed commits)")
    r = repo({"a.md": LEAK})
    git(r, "remote", "add", "mirror", PUBLIC_URL)
    case("the second push in one command", "git push origin main && git push mirror main", r, 2,
         gh="BYURL")
    r = repo({"a.md": LEAK})
    git(r, "remote", "add", "mirror", PUBLIC_URL)
    git(r, "config", "remote.pushDefault", "mirror")
    case("a bare push follows remote.pushDefault", "git push", r, 2, gh="BYURL")
    case("a push straight to a public URL", f"git push {PUBLIC_URL} main", dirty, 2, gh="BYURL")
    r = cleaned(pushed(repo({"a.md": LEAK})))
    git(r, "remote", "add", "mirror", PUBLIC_URL)
    case("history on the private remote is new to the public one", "git push mirror main", r, 2,
         gh="BYURL")

    # --- must block: the gh publish surfaces
    case("gh repo create --public --source .", "gh repo create example/x --public --source . "
         "--push", dirty, 2, gh="FAIL")
    case("gh repo create --public --source <dir>",
         f"gh repo create example/x --public --source={dirty} --push", clean, 2, gh="FAIL")
    case("gh repo create --public with a private name", "gh repo create client-portal --public",
         notrepo, 2, gh="FAIL")
    case("gh repo create --public with a private description",
         'gh repo create example/x --public -d "the Exampleville build"', notrepo, 2, gh="FAIL")
    case("gh repo create --public from a private template",
         "gh repo create example/x --public --template example/private-template", notrepo, 2,
         gh="BYURL")
    case("gh repo edit --visibility public", "gh repo edit --visibility public", dirty, 2)
    case("gh repo edit --visibility=public", "gh repo edit --visibility=public", dirty, 2)
    r = pushed(cleaned(pushed(repo({"a.md": LEAK}))))
    case("making a repo public scans already-pushed history", "gh repo edit --visibility public",
         r, 2)
    case("making another repository public", "gh repo edit example/other --visibility public",
         clean, 2)
    r = repo(untracked={"notes.md": LEAK})
    case("gh gist create --public <leaky file>", "gh gist create --public notes.md", r, 2)
    case("gh gist create -p <leaky file>", "gh gist create -p notes.md", r, 2)
    case("a public gist from stdin", "echo hi | gh gist create --public -", clean, 2)
    case("a public gist of a missing file", "gh gist create --public nowhere.md", clean, 2)
    case("a public gist with a private description",
         'gh gist create --public README.md --desc "client-portal notes"', clean, 2)
    case("gh release create on a public repo", "gh release create v1", dirty, 2)
    r = pushed(repo(untracked={"dist/notes.txt": LEAK}))
    case("a leaky release asset", "gh release create v1 dist/notes.txt", r, 2)
    case("gh release upload of a leaky asset", "gh release upload v1 dist/notes.txt", r, 2)
    case("release notes with private text", 'gh release create v1 --notes "for client-portal"',
         pushed(repo()), 2)
    case("an issue body on a public repo",
         'gh issue create -R example/public-repo -t bug -b "seen in Exampleville"', notrepo, 2,
         gh="BYURL")
    case("a PR comment from a leaky file", "gh pr comment 5 --body-file notes.md",
         repo(untracked={"notes.md": LEAK}), 2)
    case("gh pr create may push the branch first", "gh pr create -t x -b y", dirty, 2)
    case("an issue body from stdin", "gh issue comment 5 -F -", clean, 2)
    case("gh api flipping a repository public",
         "gh api -X PATCH repos/example/x -f private=false", clean, 2)
    case("gh api setting visibility=public",
         "gh api -X PATCH repos/example/x -f visibility=public", clean, 2)
    r = repo(untracked={"visibility.json": '{"visibility": "public"}\n',
                        "mutation.json": '{"query": "mutation { addComment(input: {body: '
                                         '\\"client-portal\\"}) { clientMutationId } }"}\n'})
    case("gh api --input body that flips visibility, even on a private repo",
         "gh api -X PATCH repos/example/private-repo --input visibility.json", r, 2, gh="BYURL")
    case("a GraphQL mutation sent via --input", "gh api graphql --input mutation.json", r, 2)
    case("gh api body from stdin", "gh api repos/example/x/issues --input -", r, 2,
         expect_in="stdin")
    case("gh api posting private text to {owner}/{repo} when public",
         "gh api repos/{owner}/{repo}/issues -f body=client-portal", dirty, 2)
    case("gh api posting private text",
         "gh api repos/example/x/issues -f title=hi -f body=client-portal", clean, 2)

    # --- must stay quiet
    case("a clean tree publishes", "git push origin main", clean, 0)
    case("a private destination is not this gate's business", "git push origin main", dirty, 0,
         gh="BYURL")
    case("  a bare push to a private origin", "git push", dirty, 0, gh="BYURL")
    case("  a redirected bare push still finds origin", "git push 2>&1 | tail -3", dirty, 0,
         gh="BYURL")
    case("  an ssh-form private URL", "git push git@github.com:example/private-repo.git main",
         dirty, 0, gh="BYURL")
    case("a normal push skips history the remote already has", "git push origin main",
         pushed(cleaned(pushed(repo({"a.md": LEAK})))), 0)
    case("an ignored file cannot ship", "git push",
         repo(untracked={"private/leak.md": LEAK}, ignored=["private/"]), 0)
    case("term-file comment lines are not patterns", "git push",
         repo({"README.md": CLEAN + "\n# --- location ---\n# One regex per line.\n"}), 0)
    case("a kebab-case name containing 'sk-' is not a key", "git push",
         repo({"Task-Verification-2026-09-21-and-Risk-Assessment.md": CLEAN,
               "notes.md": "See task-verification-2026-09-21 and risk-assessment-v2.\n"}), 0)
    case("a heredoc note that mentions a push",
         "cat > note.md <<'EOF'\nThen run git push origin main.\nEOF\necho saved", dirty, 0)
    case("a heredoc commit message that mentions a push",
         "git commit -m \"$(cat <<'EOF'\nfix: git push handling\nEOF\n)\"", dirty, 0)
    case("a heredoc written to script.sh is data", "cat > script.sh <<EOF\ngit push\nEOF",
         dirty, 0)
    case("a commit message that says push", 'git commit -m "ready to push"', dirty, 0)
    case("git stash push", "git stash push -m wip", dirty, 0)
    case("git log --grep push", "git log --grep push", dirty, 0)
    case("git push --dry-run sends nothing", "git push --dry-run origin main", dirty, 0)
    case("  (git push -n)", "git push -n", dirty, 0)
    case("git -c push.default=current push to a private repo",
         "git -c push.default=current push", dirty, 0, gh="BYURL")
    case("git status / fetch / commit", "git status && git fetch origin && git commit -m x",
         dirty, 0)
    case("a subshell cd does not leak out", f"(cd {dirty} && make); git push", clean, 0)
    case("pushd then popd returns", f"pushd {dirty} && popd && git push", clean, 0)
    case("gh repo create without --public", "gh repo create example/x --source . --push", dirty,
         0, gh="FAIL")
    case("gh repo create --public, nothing local", "gh repo create example/x --public", notrepo,
         0, gh="FAIL")
    case("gh repo create --public from a public template",
         "gh repo create example/x --public --template example/public-template", notrepo, 0,
         gh="BYURL")
    case("gh repo edit --visibility private", "gh repo edit --visibility private", dirty, 0)
    case("making this repository public when it is clean",
         "gh repo edit example/this-repo --visibility public", clean, 0)
    case("a secret gist (the default)", "gh gist create notes.md", dirty, 0, gh="FAIL")
    case("a public gist of a clean file", "gh gist create --public README.md", clean, 0)
    case("gh release create on a private repo", "gh release create v1", dirty, 0, gh="PRIVATE")
    case("an issue body on a private repo",
         'gh issue create -R example/private-repo -t bug -b "seen in Exampleville"', notrepo, 0,
         gh="BYURL")
    case("gh pr create --head on a private repo", "gh pr create -t x -b y --head main", dirty, 0,
         gh="PRIVATE")
    case("gh api GET", "gh api repos/example/x", clean, 0)
    case("gh api GET with query fields", "gh api -X GET search/code -f q=client-portal", clean, 0)
    case("a GraphQL read naming a private project",
         "gh api graphql -f query='query { repository(owner: \"example\", name: "
         "\"client-portal\") { id } }'", clean, 0)
    case("gh api writing to a private repository",
         "gh api repos/example/private-repo/issues -f body=client-portal", notrepo, 0,
         gh="BYURL")
    case("gh api writing to {owner}/{repo} when private",
         "gh api repos/{owner}/{repo}/issues -f body=client-portal", dirty, 0, gh="PRIVATE")
    r = repo()
    sub = r / "vendor"
    sub.mkdir()
    git(sub, "init", "-q", "-b", "main")
    (sub / "x.md").write_text(CLEAN)
    git(sub, "add", "-A")
    git(sub, "commit", "-qm", "init")
    git(r, "add", "vendor")
    git(r, "commit", "-qm", "add submodule")
    case("a repository with a submodule", "git push", r, 0)
    r = repo({"a.md": CLEAN, "b.md": CLEAN})
    (r / "b.md").unlink()
    case("a tracked file deleted from the working tree", "git push", r, 0)
    case("a bare push in a repo with no remote (git refuses)", "git push", noremote, 0,
         gh="PRIVATE")
    case("cwd is not a git repository", "git push", notrepo, 0)
    case("cwd does not exist", "git push", base / "gone", 0)
    case("a non-shell tool is ignored", "git push", dirty, 0, tool="Edit")
    raw_case("an edit whose text mentions a push is ignored",
             json.dumps({"tool_name": "Edit", "tool_input": {"file_path": "/x",
                                                             "new_string": "run git push"}}), 0)
    raw_case("malformed stdin exits 0", "{ not json", 0)
    raw_case("empty stdin exits 0", "", 0)
    raw_case("JSON that is not an object exits 0", "[]", 0)


def install(base: Path, source: str, terms_text: str) -> Path:
    d = Path(tempfile.mkdtemp(dir=base))
    (d / "pre-publish-scan.py").write_text(source)
    (d / "private-terms.txt.example").write_text(terms_text)
    return d / "pre-publish-scan.py"


def run_cases(base: Path, source: str, stop_at_first_failure: bool = False,
              first: str | None = None) -> list:
    hooks: dict = {}
    results = []
    for c in sorted(CASES, key=lambda c: c["desc"] != first):  # stable: `first` leads
        terms_text = c["terms"] if c["terms"] is not None else TERMS.read_text()
        if terms_text not in hooks:
            hooks[terms_text] = install(base, source, terms_text)
        env = {**os.environ, "PATH": f"{base / 'bin'}{os.pathsep}{os.environ.get('PATH', '')}",
               "HOME": str(base / 'home'), "GH_MODE": c["gh"], **c["env"]}
        try:
            p = subprocess.run([sys.executable, str(hooks[terms_text])], input=c["stdin"],
                               text=True, capture_output=True, env=env, timeout=120)
            out = p.stdout + p.stderr
            ok = (p.returncode == c["want"]
                  and (c["expect_in"] is None or c["expect_in"] in out)
                  and (c["must_not_print"] is None
                       or c["must_not_print"].lower() not in out.lower()))
            detail = f"exit {p.returncode}, wanted {c['want']}"
        except Exception as exc:  # a harness error is a failure, never silence
            ok, detail = False, f"harness error: {exc!r}"
        results.append((c["desc"], ok, detail))
        if stop_at_first_failure and not ok:
            break
    return results


