         notrepo, 2)
    case("  (inside an option cluster: env -iC <dir>)", f"env -iC {dirty} git push origin main",
         notrepo, 2)
    case("  (env -S'...')", "env -S'git push origin main'", dirty, 2)
    case("  (a long option's glued value: env --chdir=<dir>)",
