         expect_in="cannot run")
    case("an external cd's target stays a candidate (timeout)",
         f"timeout 5 cd {dirty}; git push origin main", notrepo, 2)
    case("  (coproc)", f"coproc cd {dirty}; git push origin main", notrepo, 2)
    case("an unknown option may take the next word as its value (nice -Z echo ...)",
