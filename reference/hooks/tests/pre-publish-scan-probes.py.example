# The case that caught each mutation on the last full run. It is tried first, which keeps CI
# fast; a stale or missing entry only costs time, never correctness.
CAUGHT_BY = {
    '$SHELL heredoc read as data': 'a heredoc fed to $SHELL',
    '--dry-run treated as a publish': 'git push --dry-run sends nothing',
    '--git-dir allowed': 'git --git-dir',
