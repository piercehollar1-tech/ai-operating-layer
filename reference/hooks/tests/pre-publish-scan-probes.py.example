# The case that caught each mutation on the last full run. It is tried first, which keeps CI
# fast; a stale or missing entry only costs time, never correctness.
CAUGHT_BY = {
    '$SHELL heredoc read as data': 'a heredoc fed to $SHELL',
    '--dry-run treated as a publish': 'git push --dry-run sends nothing',
    '--git-dir allowed': 'git --git-dir',
    '--mirror and custom refs not traversed': '--mirror publishes notes too',
    '-c remote config trusted': 'git -c remote.X.url=... push',
    'GIT_DIR= prefix trusted': 'GIT_DIR=... git push',
    'GraphQL reads scanned': 'a GraphQL read naming a private project',
    'LFS objects not scanned': 'a Git LFS object',
    'Latin-1 fallback dropped': 'a non-ASCII term in a Latin-1 file',
    'UTF-8 decoding dropped': 'git push to a public repository',
    'VAR= prefix not stripped': 'GIT_DIR=... git push',
    'aliases not expanded': 'an alias chain deeper than the parser follows',
    'another repo made public allowed': 'making another repository public',
    "any 'sh' substring counts as a shell": 'a heredoc written to script.sh is data',
    'any push word counts': 'git submodule foreach git push',
    'binary staged diff hidden': 'a staged binary blob',
    'branch/tag names not scanned': 'a private branch name',
    'cd ignored': 'a cd target built from a variable',
    'commit messages not scanned': 'a private commit message',
    'configured push refspecs ignored': 'a configured push refspec that sends notes',
    'crash exits 1 (open)': 'a crash blocks (a non-string cwd)',
    'denylist load error allowed': 'a bad regex in the term file',
    'detached HEAD not in range': 'a detached HEAD pushed to a branch',
    'diff content lines starting ++ skipped': "a staged line that itself starts with '++'",
    'empty denylist allowed': 'an empty term file',
    'eval not followed': 'eval "git push"',
    'every push scans all history': '  QUIET: a normal push does not send notes',
    'failed cd drops the old dir': 'a failed cd leaves the shell where it was',
    'fetch URL checked instead of push URL': 'a push URL that differs from the fetch URL',
    'fetch tracking refs trusted for a different push repo': 'fetch-side tracking refs do not describe the push repo',
    'file name echoed': '  and still hidden when the contents leak too',
    'file names not scanned': 'a private file name, not echoed',
    'force-add not detected': 'a force-added ignored file',
    'gh api GET scanned': 'gh api GET with query fields',
    'gh api body files not read for visibility/mutation': 'gh api --input body that flips visibility, even on a private repo',
    'gh api fields not scanned': 'gh api posting private text to {owner}/{repo} when public',
    'gh api stdin body allowed': 'git push to a public repository',
    'gh api to a private repo scanned': 'gh api writing to a private repository',
    'gh api visibility change allowed': 'gh api flipping a repository public',
    'gist -p missed': "  (gh's help unreadable, so -p is read as written)",
    'gist description not scanned': 'a public gist with a private description',
    'git -C ignored': 'git -C <dir> push',
    'heredoc bodies read as commands': 'a heredoc written to script.sh is data',
    'heredoc fed to a shell dropped': 'a heredoc fed to bash',
    'history the PRIVATE remote has is skipped for a public one': 'history on the private remote is new to the public one',
    'if/then/do not stripped': 'a push inside if/then',
    'ignored files always scanned': 'an ignored file cannot ship',
    'issue/PR body files not scanned': 'a PR comment from a leaky file',
    'issue/PR stdin body allowed': 'an issue body from stdin',
    'issue/PR text not scanned': 'an issue body on a public repo',
    'lfs.storage ignored': 'a Git LFS object in a custom lfs.storage',
    'making public scans only unpushed history': 'making a repo public scans already-pushed history',
    'malformed payload allowed': 'a malformed payload that could be a publish',
    'mirror config ignored': 'a remote configured as a mirror',
    'nesting limit stops silently': 'an alias chain deeper than the parser follows',
    'newline not a separator': 'cd on one line, push on the next',
    'non-shell tools not screened out first': 'a non-shell tool is ignored',
    'only the first push URL checked': 'a private AND a public push URL',
    "plain git aliases lose their 'git'": 'a git alias that pushes',
    'popd ignored': 'pushd then popd returns',
    'pr create push not considered': 'gh pr create may push the branch first',
    'private template allowed': 'gh repo create --public from a private template',
    'public gist from stdin allowed': 'a public gist from stdin',
    'quoted $(...) not walked': 'a push inside a quoted $(...)',
    'quotes ignored when matching $( ... ) parens': "a quoted ')' inside a quoted $(...)",
    'redirections read as arguments': '  a redirected bare push still finds origin',
    'refspec sources not in range': 'a commit pushed by hash',
    'release assets not scanned': 'gh release upload of a leaky asset',
    'release notes not scanned': 'release notes with private text',
    'release visibility ignored': 'gh release create on a public repo',
    'remote-less short-circuit ignores pushDefault': 'a remote-less repo whose pushDefault is a URL',
    'remote-less short-circuit removed': 'a bare push in a repo with no remote (git refuses)',
    'repo create --source ignored': 'gh repo create --public --source .',
    'repo create without --public scanned': 'gh repo create without --public',
    'repo name/description not scanned': 'gh repo create --public with a private name',
    'report echoes the matched line': '  and the report never echoes the private text',
    'report lists a hit once per decoding': "a non-ASCII file's hit is reported once, not per decoding",
    'sh -c not followed': "bash -lc 'cd <dir> && git push'",
    'size cap removed': 'a file over the size cap',
    'staged diff not run with the shared diff args': 'a staged binary blob',
    'staged index not scanned': 'a leak only in the staged index',
    'submodule foreach push allowed': 'git submodule foreach git push',
    'submodules and deleted files unscannable': 'a repository with a submodule',
    'subshell cd leaks out': 'a subshell cd does not leak out',
    'symlinks followed instead of read': "a symlink's target text",
    'time budget allowed': 'a scan past its time budget',
    'timeout wrapper not stripped': 'timeout 60 git push',
    'unknown remote assumed private': 'an unknown remote counts as public',
    'unpushed commits not scanned': 'a leak only in an unpushed commit',
    'unreadable file allowed': 'an unreadable file',
    'unresolved visibility assumed private': 'unresolved visibility counts as public',
    'unscannable files allowed': 'a file over the size cap',
    'unseen publishes allowed': 'a cd target built from a variable',
    'unterminated heredoc dropped': 'an unterminated heredoc is kept whole',
    'untracked files not scanned': 'an untracked file added in the same command',
    'variable cd trusted': 'a cd target built from a variable',
    'visibility change not detected': 'gh repo edit --visibility public',
}


def main() -> int:
    if shutil.which("git") is None:
        print("FAIL: git is required", file=sys.stderr)
        return 1
    source = HOOK.read_text()
    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp)
        (base / "bin").mkdir()
        (base / "home").mkdir()
        (base / "bin" / "gh").write_text(GH_STUB)
        (base / "bin" / "gh").chmod(0o755)
        build(base)
        failed = 0

        print(f"{len(CASES)} cases against the hook as written:")
        for desc, ok, detail in run_cases(base, source):
            if not ok:
                print(f"  FAIL  {desc}  ({detail})")
            failed += not ok

        def unusable(mutation):
            label, old, new = mutation
            if source.count(old) != 1:
                return f"  STALE     {label}  (target text found {source.count(old)} times)"
            try:
                compile(source.replace(old, new), label, "exec")
            except SyntaxError:
                return f"  BROKEN    {label}  (the mutant does not compile)"
            return None

        if "--mutations" not in sys.argv[1:]:
            bad = [line for line in map(unusable, MUTATIONS) if line]
            for line in bad:
                print(line)
            print(f"{len(MUTATIONS)} mutations not run, only checked to still apply and compile "
                  f"({len(bad)} do not). After changing the hook, run with --mutations.")
            print(f"{len(CASES) - failed}/{len(CASES)} cases passed.")
            return 1 if failed or bad else 0

        def mutate(mutation):
            label, old, new = mutation
            problem = unusable(mutation)
            if problem:
                return problem, True
            red = [d for d, ok, _ in run_cases(base, source.replace(old, new), True,
                                               CAUGHT_BY.get(label)) if not ok]
            if red:
                return f"  KILLED    {label}  by: {red[0]}", False
            return f"  SURVIVED  {label}", True

        print(f"{len(MUTATIONS)} mutations (each must turn at least one case red):")
        workers = int(os.environ.get("PROBE_WORKERS", "4"))  # lower it on a small or hot machine
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            for line, bad in pool.map(mutate, MUTATIONS):
                print(line)
                failed += bad

        total = len(CASES) + len(MUTATIONS)
        print(f"{total - failed}/{total} checks passed.")
        return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
